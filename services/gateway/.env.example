# Settings for running the gateway natively (`make run-gateway`) against the
# infrastructure started by `make infra`. Copied to .env (git-ignored) on first use.
# Values match the development defaults in the root .env.example.
GATEWAY_DATABASE_URL=postgresql+psycopg://gateway:gateway_dev_password@localhost:5432/gateway
GATEWAY_REDIS_URL=redis://:redis_dev_password@localhost:6379/0
GATEWAY_RABBITMQ_URL=amqp://payments:rabbitmq_dev_password@localhost:5672/
GATEWAY_LEDGER_URL=http://localhost:8080
GATEWAY_MOCK_BANK_URL=http://localhost:8001
