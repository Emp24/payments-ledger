# Development defaults only. Copy to .env (`make up` does this if .env is missing)
# and change the passwords for anything that is not a local machine.

# --- Host ports (only these are published) ---
GATEWAY_PORT=8000
RABBITMQ_MANAGEMENT_PORT=15672

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
LEDGER_DB_USER=ledger
LEDGER_DB_PASSWORD=ledger_dev_password
GATEWAY_DB_USER=gateway
GATEWAY_DB_PASSWORD=gateway_dev_password

# --- RabbitMQ ---
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=rabbitmq_dev_password

# --- Redis ---
REDIS_PASSWORD=redis_dev_password

# --- Connection strings (built from the values above) ---
LEDGER_POSTGRES_CONNECTION=Host=postgres;Port=5432;Database=ledger;Username=${LEDGER_DB_USER};Password=${LEDGER_DB_PASSWORD}
LEDGER_RABBITMQ_CONNECTION=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/
LEDGER_REDIS_CONNECTION=redis:6379,password=${REDIS_PASSWORD}

GATEWAY_DATABASE_URL=postgresql+psycopg://${GATEWAY_DB_USER}:${GATEWAY_DB_PASSWORD}@postgres:5432/gateway
GATEWAY_RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/
GATEWAY_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
GATEWAY_LEDGER_URL=http://ledger:8080
GATEWAY_MOCK_BANK_URL=http://mock-bank:8000
